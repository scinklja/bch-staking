pragma cashscript ^0.14.0;
// Fixed-width state: period(4), phase(1), count(1), live(16*49), snapshot(16*49).
// Record: pubkey(33), S(4), T blocks(4), R(4), maxWins(1), wins(1), cancelled(1), withdrawn(1).
contract Registry(bytes32 category, int firstHeight, int spacing, int periods, int cap) {
    function transition(bytes state, int action, int slot, bytes record, sig authorization) {
        require(this.activeInputIndex == 0);
        require(firstHeight > 0 && firstHeight < 500000000 && spacing > 0);
        require(periods > 0 && periods <= 16 && cap >= 1000 && cap <= 1000000);
        require(firstHeight + (periods - 1) * spacing < 500000000);
        require(state.length == 1574);
        require(tx.inputs[0].nftCommitment == hash256(state));
        require(tx.inputs[0].tokenCategory == category + 0x01);
        require(tx.inputs[0].tokenAmount == 0);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenCategory == category + 0x01);
        require(tx.outputs[0].tokenAmount == 0);
        int period = int(state.slice(0,4));
        int phase = int(state.slice(4,5));
        int count = int(state.slice(5,6));
        require(period >= 0 && period <= periods);
        require(count >= 0 && count <= 16);
        require(phase == 0 || phase == 1);
        bytes live = state.slice(6,790);
        bytes snapshot = state.slice(790,1574);
        bytes next = state;
        int value = tx.inputs[0].value - 10000;
        if (action == 0) {
            require(phase == 0 && count < 16 && period < periods);
            require(slot == count);
            require(record.length == 49);
            int s = int(record.slice(33,37));
            int t = int(record.slice(37,41));
            int r = int(record.slice(41,45));
            int maximum = int(record.slice(45,46));
            require(s >= 1000 && s <= 1000000);
            require(t > 0 && t <= 65535);
            require(r >= 1000 && r <= cap && cap <= 1000000);
            require(maximum > 0 && maximum <= periods);
            require(record.slice(46,49) == 0x000000);
            require(checkSig(authorization, pubkey(record.slice(0,33))));
            require(tx.inputs.length == 2 && tx.outputs.length == 1);
            require(tx.inputs[1].value == s + 10000);
            require(tx.inputs[1].tokenCategory == 0x);
            value = tx.inputs[0].value + s;
            live = live.slice(0,slot*49) + record + live.slice((slot+1)*49,784);
            next = state.slice(0,5) + toPaddedBytes(count + 1, 1) + live + snapshot;
        } else if (action == 1) {
            require(tx.inputs.length == 1 && tx.outputs.length == 1);
            require(slot >= 0 && slot < count);
            bytes entry = live.slice(slot*49,(slot+1)*49);
            require(checkSig(authorization, pubkey(entry.slice(0,33))));
            require(entry.slice(47,48) == 0x00);
            live = live.slice(0,slot*49+47) + 0x01 + live.slice(slot*49+48,784);
            next = state.slice(0,6) + live + snapshot;
        } else if (action == 2) {
            require(tx.inputs.length == 1 && tx.outputs.length == 1);
            require(phase == 0 && period < periods);
            require(tx.time >= firstHeight + period * spacing);
            next = state.slice(0,4) + 0x01 + state.slice(5,6) + live + live;
        } else if (action == 3) {
            require(tx.inputs.length == 1 && tx.outputs.length == 2);
            require(phase == 1);
            require(slot >= 0 && slot < count);
            bytes winner = snapshot.slice(slot*49,(slot+1)*49);
            int s = int(winner.slice(33,37));
            int t = int(winner.slice(37,41));
            int r = int(winner.slice(41,45));
            require(winner.slice(47,49) == 0x0000);
            require(int(winner.slice(46,47)) < int(winner.slice(45,46)));
            for (int i = 0; i < 16; i++) {
                if (i < count) {
                    bytes candidate = snapshot.slice(i*49,(i+1)*49);
                    if (candidate.slice(47,49) == 0x0000 && int(candidate.slice(46,47)) < int(candidate.slice(45,46))) {
                        int left = s * t * int(candidate.slice(41,45));
                        int right = int(candidate.slice(33,37)) * int(candidate.slice(37,41)) * r;
                        require(left >= right);
                        if (i < slot) { require(left > right); }
                    }
                }
            }
            bytes entry = live.slice(slot*49,(slot+1)*49);
            live = live.slice(0,slot*49+46) + toPaddedBytes(int(entry.slice(46,47)) + 1, 1) + live.slice(slot*49+47,784);
            next = toPaddedBytes(period + 1, 4) + 0x00 + state.slice(5,6) + live + snapshot;
            require(tx.outputs[1].lockingBytecode == new LockingBytecodeP2PKH(hash160(winner.slice(0,33))));
            require(tx.outputs[1].value == r);
            value = value - r;
        } else if (action == 5) {
            require(tx.inputs.length == 1 && tx.outputs.length == 1);
            require(phase == 1);
            for (int k = 0; k < 16; k++) {
                if (k < count) {
                    bytes candidate = snapshot.slice(k*49,(k+1)*49);
                    require(candidate.slice(47,49) != 0x0000 || int(candidate.slice(46,47)) >= int(candidate.slice(45,46)));
                }
            }
            next = toPaddedBytes(period + 1, 4) + 0x00 + state.slice(5,6) + live + snapshot;
        } else {
            require(action == 4);
            require(tx.inputs.length == 1 && tx.outputs.length == 2);
            require(phase == 0 && slot >= 0 && slot < count);
            bytes entry = live.slice(slot*49,(slot+1)*49);
            require(checkSig(authorization, pubkey(entry.slice(0,33))));
            require(entry.slice(47,49) == 0x0100);
            if (int(entry.slice(46,47)) > 0) { require(this.age >= int(entry.slice(37,41))); }
            int s = int(entry.slice(33,37));
            live = live.slice(0,slot*49+48) + 0x01 + live.slice(slot*49+49,784);
            next = state.slice(0,6) + live + snapshot;
            require(tx.outputs[1].lockingBytecode == new LockingBytecodeP2PKH(hash160(entry.slice(0,33))));
            require(tx.outputs[1].value == s);
            value = value - s;
        }
        int collateral = 0;
        for (int j = 0; j < 16; j++) {
            if (j < int(next.slice(5,6)) && next.slice(6+j*49+48,6+j*49+49) == 0x00) {
                collateral = collateral + int(next.slice(6+j*49+33,6+j*49+37));
            }
        }
        require(value >= collateral + (periods - int(next.slice(0,4))) * cap + 1000);
        require(tx.outputs[0].nftCommitment == hash256(next));
        require(tx.outputs[0].value == value);
    }
}
