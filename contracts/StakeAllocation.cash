pragma cashscript ^0.14.0;
// Terms: owner(33), vault category(32), offer slot(1), period(4), S(4), maturity(4), asset(32).
// Immutable terms are part of this UTXO's redeem script, not caller-supplied witnesses.
contract StakeAllocation(bytes110 terms) {
    function withdraw(sig authorization) {
        require(this.activeInputIndex == 0);
        require(tx.inputs.length == 1 && tx.outputs.length == 1);
        require(checkSig(authorization, pubkey(terms.slice(0,33))));
        require(tx.time >= int(terms.slice(74,78)));
        require(tx.inputs[0].value == 2000);
        require(tx.inputs[0].tokenCategory == terms.slice(78,110));
        require(tx.inputs[0].nftCommitment == 0x);
        require(tx.inputs[0].tokenAmount == int(terms.slice(70,74)));
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(hash160(terms.slice(0,33))));
        require(tx.outputs[0].value == 1000);
        require(tx.outputs[0].tokenCategory == terms.slice(78,110));
        require(tx.outputs[0].nftCommitment == 0x);
        require(tx.outputs[0].tokenAmount == int(terms.slice(70,74)));
    }
}
