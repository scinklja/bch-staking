[Unit]
Description=Staking Arena chipnet development services
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=%h/bch-staking
Environment=FRONTEND_HOST=0.0.0.0
ExecStart=%h/.local/share/mise/installs/node/24/bin/node %h/bch-staking/scripts/dev.mjs
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=180
UMask=0077

[Install]
WantedBy=default.target
