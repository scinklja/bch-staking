{
  "name": "bch-staking",
  "version": "0.3.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "node:start": "bash scripts/node.sh start",
    "node:stop": "bash scripts/node.sh stop",
    "node:status": "bash scripts/node.sh status",
    "mine": "bash scripts/node.sh mine",
    "compile": "cashc contracts/Example.cash --output artifacts/Example.json",
    "typecheck": "tsc",
    "test": "npm run compile && npm run compile:vault && npm run compile:period && npm run compile:registry && npm run typecheck && node scripts/test-regressions.mjs",
    "compile:vault": "cashc contracts/Vault.cash --output artifacts/Vault.json && cashc contracts/StakeLock.cash --output artifacts/StakeLock.json",
    "compile:period": "cashc contracts/DeadlineProbe.cash --output artifacts/DeadlineProbe.json && cashc contracts/PeriodOpen.cash --output artifacts/PeriodOpen.json",
    "compile:registry": "node scripts/compile-registry.mjs",
    "arena": "tsx scripts/arena.ts",
    "test:arena": "ARENA_NETWORK=regtest tsx --test --test-concurrency=1 tests/arena*.test.ts",
    "frontend": "tsx scripts/frontend.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "frontend:test": "npm --prefix frontend test",
    "frontend:test:browser": "npm --prefix frontend run test:browser",
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev.mjs stop",
    "test:dev": "ARENA_NETWORK=regtest node tests/dev-lifecycle.test.mjs",
    "chipnet:status": "tsx scripts/chipnet.ts status",
    "chipnet:start": "bash scripts/chipnet-node.sh start",
    "chipnet:stop": "bash scripts/chipnet-node.sh stop",
    "chipnet:provision": "tsx scripts/chipnet-provision.ts",
    "test:chipnet:local": "tsx --test --test-concurrency=1 tests/chipnet*.test.ts",
    "chipnet:funding": "tsx scripts/chipnet-funding.ts",
    "chipnet:relay": "tsx scripts/chipnet-relay-check.ts",
    "chipnet:record": "tsx scripts/chipnet.ts record",
    "chipnet:fund-wallet": "tsx scripts/chipnet-fund-wallet.ts",
    "chipnet:wait": "tsx scripts/chipnet-wait-confirmation.ts",
    "chipnet:verify": "tsx scripts/chipnet-verify-e2e.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "buffer": "6.0.3",
    "cashc": "0.14.0",
    "cashscript": "0.14.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
