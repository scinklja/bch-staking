# Public build-time configuration. Changes require a rebuild. Never put credentials or keys here.
# Production without an API URL defaults to browser Electrum on chipnet.
# Development without overrides retains /api for the optional Node service.
# VITE_INDEXER_MODE=electrum
# VITE_ELECTRUM_ENDPOINTS=wss://chipnet.bch.ninja:50004,wss://chipnet.imaginary.cash:50004
# VITE_ARENA_NETWORK=chipnet
# VITE_ARENA_VAULTS=[{"genesis":"...","stakingCategory":"...","epoch":1794380640,"periodSeconds":60,"periods":1,"cap":2000}]
# Defaults use the real chipnet vault in config/electrum-chipnet.json.
# VITE_ELECTRUM_TIMEOUT_MS=10000
# VITE_ELECTRUM_POLL_MS=15000
# VITE_ELECTRUM_MAX_HISTORY=50000
# VITE_ELECTRUM_MAX_TRANSACTIONS=20000
# VITE_ELECTRUM_MAX_RAW_BYTES=16777216
# Optional independent HTTPS read-only API (automatically selects API mode):
# VITE_API_BASE_URL=https://indexer.example.com
# VITE_INDEXER_MODE=api
# Explicitly disable network reads for preview-only builds:
# VITE_INDEXER_MODE=off
